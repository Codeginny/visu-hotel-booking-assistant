{
  // Frontend (web/ → public/): el navegador carga los .js que genera tsc, sin bundler.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "rootDir": "web",
    "outDir": "public",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["web"]
}
